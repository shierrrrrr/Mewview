<Window x:Class="Mewview.ConfirmSaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="是否覆盖原图保存？"
                   FontSize="14"
                   Foreground="{StaticResource TextPrimaryBrush}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="确定"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="76" Padding="0,6"
                    IsDefault="True"
                    ToolTip="覆盖原图保存"
                    Click="OnConfirmClick" />
            <Button Content="另存为"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="76" Padding="0,6" Margin="8,0,0,0"
                    ToolTip="保存为新文件"
                    Click="OnSaveAsClick" />
            <Button Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="76" Padding="0,6" Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
