<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Unified line-icon set (Spec §29): all drawn on a 20x20 grid,
         single 1.5px round-capped stroke. No emoji, no PNG, no mix
         of icon libraries. Render via ToolIcon / BarIcon styles.
         ============================================================ -->

    <!-- Navigation -->
    <StreamGeometry x:Key="IconPrev">M12.5 4.5 L6.5 10 L12.5 15.5</StreamGeometry>
    <StreamGeometry x:Key="IconNext">M7.5 4.5 L13.5 10 L7.5 15.5</StreamGeometry>

    <!-- File -->
    <StreamGeometry x:Key="IconOpen">M2.5 5.5 H7.5 L9.5 7.5 H17.5 V15.5 H2.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSave">M4 3 H13.5 L16.5 6 V17 H4 Z M6.5 3 V7 H13 M6.5 12 H13.5 V17</StreamGeometry>

    <!-- Edit history -->
    <StreamGeometry x:Key="IconUndo">M8 5 L4 9 L8 13 M4 9 H12 C15 9 16 11 16 12.8 C16 14.6 15 16.5 12 16.5 H8</StreamGeometry>
    <StreamGeometry x:Key="IconRedo">M12 5 L16 9 L12 13 M16 9 H8 C5 9 4 11 4 12.8 C4 14.6 5 16.5 8 16.5 H12</StreamGeometry>

    <!-- Window / OCR -->
    <StreamGeometry x:Key="IconPin">M7 2.5 H13 M10 2.5 V7.5 M7 7.5 H13 L14.5 12 H5.5 Z M10 12 V17.5</StreamGeometry>
    <StreamGeometry x:Key="IconOcr">M2.5 6.5 V3.5 H5.5 M14.5 3.5 H17.5 V6.5 M17.5 13.5 V16.5 H14.5 M5.5 16.5 H2.5 V13.5 M5 10 H15</StreamGeometry>

    <!-- Editor tools -->
    <StreamGeometry x:Key="IconSelect">M6 2.5 L15.5 10 L11 11 L13.2 16 L11.3 16.8 L9.1 12 L6 15 Z</StreamGeometry>
    <StreamGeometry x:Key="IconLine">M4 16 L16 4</StreamGeometry>
    <StreamGeometry x:Key="IconArrow">M4.5 15.5 L15 5 M15 5 H10 M15 5 V10</StreamGeometry>
    <StreamGeometry x:Key="IconRect">M3 4.5 H17 V15.5 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconText">M4.5 4 H15.5 M10 4 V16 M7.5 16 H12.5</StreamGeometry>
    <StreamGeometry x:Key="IconCrop">M6.5 2.5 V13.5 H17.5 M13.5 17.5 V6.5 H2.5</StreamGeometry>

</ResourceDictionary>
